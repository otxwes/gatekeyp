# gatekeyp Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

# Required: organizer key. This is the Fernet encryption-at-rest key, so it
# MUST be a url-safe base64 encoding of 32 random bytes (44 chars). The
# example token_hex() form is NOT accepted by Fernet and will fail to boot.
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
GATEKEYP_ORGANIZER_KEY=

# Required: HMAC secret for keyed key-hashing / message authentication (any
# strong random value, min 32 bytes recommended).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GATEKEYP_HMAC_SECRET=

# Optional: Database path (command line arg > this env var > "keys.db").
# GATEKEYP_DB_PATH=/app/data/keys.db

# Optional: API host/port (server.main() defaults to 127.0.0.1:8000; the
# Docker container and compose override host to 0.0.0.0).
# GATEKEYP_HOST=0.0.0.0
# GATEKEYP_PORT=8000

# Optional: LXMF/Reticulum mesh key delivery (experimental, off by default)
# GATEKEYP_LXMF_ENABLED=1
# GATEKEYP_LXMF_STATE=./lxmf_state
# GATEKEYP_LXMF_RNS_CONFIG=./rns_config
