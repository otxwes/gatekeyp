# Gatekeyp Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

# Required: Master key for key derivation (min 32 bytes, use a strong random value)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GATEKEYP_MASTER_KEY=

# Required: HMAC secret for message authentication (min 32 bytes)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GATEKEYP_HMAC_SECRET=

# Optional: Database path (defaults to ./data/gatekeyp.db)
# GATEKEYP_DB_PATH=./data/gatekeyp.db

# Optional: API host/port (defaults to 0.0.0.0:8000)
# GATEKEYP_HOST=0.0.0.0
# GATEKEYP_PORT=8000
